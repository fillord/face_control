# SQLite database — do not commit (DB-05)
data/app.db

# Face recognition runtime data — generated at startup, do not commit
data/encodings.json
data/faces/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/
.venv/
env/

# Python egg / distribution
*.egg-info/
dist/
build/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
*.swp
*.swo

# Внутренние заметки GSD — не часть продукта (GH-IGNORE)
.planning/

# Конфигурация агента — не часть продукта
.claude/

